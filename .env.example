# Optional: copy to .env to override Compose's identical development defaults.
# Compose hostnames are postgres/redis; use localhost when running on the host.
POSTGRES_USER=tsuyu
POSTGRES_PASSWORD=tsuyu-dev-only
POSTGRES_DB=tsuyulabo
# Keep DATABASE_URL consistent if changing any POSTGRES_* value above.
DATABASE_URL=postgresql+asyncpg://tsuyu:tsuyu-dev-only@postgres:5432/tsuyulabo
REDIS_URL=redis://redis:6379/0
JWT_SECRET=tsuyulabo-local-development-only-change-in-production
TSUYU_DEV_TOOLS=1
BRAIN_MODE=queue
CORS_ORIGINS='["http://localhost:3000"]'

# Server guard: Redis fixed windows use UTC wall time (not the game clock).
RATE_LIMITS_ENABLED=true
# Funnel overwrites X-Forwarded-For with its source IP; see docs/selfhost.md.
# Use 0 for a direct API connection, 1 for Funnel, 2 only for an append-style chain.
TRUSTED_PROXY_HOPS=1
RATE_GUEST_HOUR=5
RATE_GUEST_DAY_GLOBAL=200
# Per API process, used only during Redis failure (a single bounded counter).
RATE_GUEST_FALLBACK_HOUR_GLOBAL=10
RATE_SHIORI_MINUTE=10
RATE_SHIORI_DAY=100
RATE_BRAIN_MINUTE=20
RATE_PUZZLE_MINUTE=60
RATE_FRIENDS_MINUTE=30
RATE_AUTHENTICATED_MINUTE=300
JOB_MAX_PER_USER=2
JOB_MAX_TOTAL=20
JOB_BUSY_RETRY_AFTER=10
WORKER_MAX_JOBS=2

# Browser-visible URL; do not use the internal Compose hostname api here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_TOOLS=1

# MockProvider is the default. Real provider credentials are optional.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Switch to ollama only after reading services/shiori/reports/local-llm.md.
SHIORI_PROVIDER=mock
# Compose talks to the owner's host; for host Python use http://127.0.0.1:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_QA_MODEL=qwen3.5:4b
OLLAMA_JOURNAL_MODEL=qwen3.5:2b-q4_K_M
# Always bound context to keep the small model on the laptop GPU.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=120
# Local evaluation only (never enabled in CI).
SHIORI_LIVE_EVAL=0
